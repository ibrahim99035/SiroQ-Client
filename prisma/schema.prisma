// SiroQ Client — system of record for the multi-tenant pharmacy application
// review workspace.
//
// SCOPE BOUNDARY
// This schema is the *application management* domain: tenants (associations),
// pharmacies, users/roles, filings (applications), the files inside them, and
// the reports attached to them.
//
// The separate "SiroQ Analysis Service" (Python/FastAPI) owns its own database
// where it performs column profiling, data-quality scoring, canonical-field
// classification and forecasting. It also has a table named `applications` with
// a completely different meaning. We therefore link to it explicitly through
// AnalysisRun/`Application.analysisApplicationId` and never by name.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums ----

enum Role {
  super_admin
  moderator
  pharmacy_association_admin
  pharmacy_worker
}

enum UserStatus {
  active
  invited
  disabled
}

enum EntityStatus {
  active
  suspended
}

enum ApplicationStatus {
  pending
  in_review
  reported
  rejected
}

enum FileKind {
  xlsx
  xls
  csv

  /// Anything stored as supporting evidence rather than analysed as a
  /// dispensing ledger: Power BI (.pbix/.pbit), Tableau (.twb/.twbx/.tds/
  /// .tdsx/.hyper) and raw data formats (.parquet/.json/.sql/.pdf).
  ///
  /// One bucket, not one value per format. The concrete format is already on
  /// `ApplicationFile.originalName` and `mimeType`, so a per-format enum would
  /// buy no queryable distinction while adding a branch to every `kind ===`
  /// test. Keeping the analysable kinds as the three named values is what lets
  /// the analysis route gate on `kind IN (xlsx, xls, csv)` in one clause.
  attachment
}

enum FileValidationState {
  valid
  warning
  invalid
}

/// Where a file is in the intake/parse pipeline.
enum ParseState {
  pending
  parsing
  parsed
  failed
}

/// State of a pending direct-to-storage upload slot.
enum UploadState {
  pending
  ready
  failed
  expired
}

enum ReportStatus {
  draft
  final
}

/// What happened to a file on a filing. Append-only: see `FileEvent`.
enum FileEventKind {
  uploaded
  replaced
  deleted
}

/// Who produced the report. `manual` = attached by a super admin;
/// `service` = produced by the SiroQ Analysis Service.
enum ReportSource {
  manual
  service
}

/// Outcome of a call out to the analysis service.
enum AnalysisRunStatus {
  queued
  running
  succeeded
  failed
}

// --------------------------------------------------------------- tenants ----

/// Top-level tenant. An association admin is scoped to exactly one of these.
model PharmacyAssociation {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  region           String
  gmpCertificateId String       @map("gmp_certificate_id")
  status           EntityStatus @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  pharmacies   Pharmacy[]
  users        User[]
  applications Application[]

  @@index([status])
  @@map("pharmacy_associations")
}

/// A licensed dispensing site. A pharmacy worker is scoped to exactly one.
model Pharmacy {
  id            String       @id @default(uuid()) @db.Uuid
  associationId String       @map("association_id") @db.Uuid
  name          String
  address       String
  licenseNumber String       @map("license_number")
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  association  PharmacyAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)
  users        User[]
  applications Application[]

  @@index([associationId])
  @@index([status])
  @@map("pharmacies")
}

// ------------------------------------------------------------------ users ---

model User {
  id String @id @default(uuid()) @db.Uuid

  email String @unique
  name  String

  /// NULL until the invite is accepted / password is set.
  passwordHash String? @map("password_hash")

  role   Role
  status UserStatus @default(invited)

  /// Set for `pharmacy_association_admin` (and super admin acting in tenant).
  associationId String? @map("association_id") @db.Uuid
  /// Set for `pharmacy_worker`.
  pharmacyId    String? @map("pharmacy_id") @db.Uuid

  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  association PharmacyAssociation? @relation(fields: [associationId], references: [id], onDelete: SetNull)
  pharmacy    Pharmacy?            @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  sessions       Session[]
  passwordResets PasswordResetToken[]
  submittedFiles ApplicationFile[]    @relation("FileUploader")
  submittedApps  Application[]        @relation("AppSubmitter")
  statusEvents   StatusEvent[]
  fileEvents     FileEvent[]          @relation("FileEventActor")
  reports        Report[]
  uploads        Upload[]             @relation("UploadOwner")
  analysisRuns   AnalysisRun[]
  extractionRuns ExtractionRun[] @relation("ExtractionRequester")
  invitedBy      User?                @relation("UserInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById    String?              @map("invited_by_id") @db.Uuid
  invitedUsers   User[]               @relation("UserInviter")

  @@index([role])
  @@index([status])
  @@index([associationId])
  @@index([pharmacyId])
  @@map("users")
}

/// Server-side session. The cookie carries only an opaque token; the token's
/// SHA-256 is what we store, so a database read cannot be replayed as a login.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------- applications ---

/// A filing: one pharmacy submitting one or more dispensing-data files for
/// review. Progresses pending -> in_review -> reported (or rejected) and keeps
/// a full audit trail.
model Application {
  id    String @id @default(uuid()) @db.Uuid
  title String

  /// Human-readable filing reference shown throughout the UI (e.g. AP-2026-2601).
  /// Kept separate from the UUID primary key so database identity never leaks
  /// into the interface.
  ///
  /// Allocated by `application_reference_seq` (see
  /// `prisma/migrations/20260930_application_reference_seq`). Declared
  /// `dbgenerated` so the database stays the only allocator: the client omits
  /// this field entirely, which is what stops two concurrent requests inventing
  /// the same reference and colliding on the unique index. Prisma still returns
  /// the generated value from the insert, so callers read it back in the same
  /// round trip rather than re-querying.
  reference String @unique @default(dbgenerated("('AP-2026-'::text || lpad((nextval('application_reference_seq'::text))::text, 4, '0'::text))"))

  pharmacyId    String @map("pharmacy_id") @db.Uuid
  /// Denormalised from the pharmacy so tenant scoping needs no join.
  associationId String @map("association_id") @db.Uuid
  submittedById String @map("submitted_by_id") @db.Uuid

  status      ApplicationStatus @default(pending)
  submittedAt DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Link to the SiroQ Analysis Service's own application record. Null until
  /// the filing is first sent there. Never join across databases by name.
  analysisApplicationId String? @map("analysis_application_id")
  analysisName          String? @map("analysis_name")

  pharmacy    Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  association PharmacyAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)
  submittedBy User                @relation("AppSubmitter", fields: [submittedById], references: [id])

  files        ApplicationFile[]
  events       StatusEvent[]
  fileEvents   FileEvent[]
  report       Report?
  uploads      Upload[]
  analysisRuns AnalysisRun[]

  @@index([pharmacyId])
  @@index([associationId])
  @@index([status])
  @@index([submittedAt])
  @@map("applications")
}

/// An uploaded .xlsx/.csv. Validation and parse metadata are computed
/// server-side from the file's actual bytes — never supplied by the client.
model ApplicationFile {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  originalName   String   @map("original_name")
  kind           FileKind
  mimeType       String   @map("mime_type")
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String   @map("checksum_sha256")
  storageKey     String   @map("storage_key")
  storageDriver  String   @map("storage_driver")

  /// Server-computed parse results.
  parseState      ParseState @default(pending) @map("parse_state")
  parseError      String?    @map("parse_error")
  rowCount        Int        @default(0) @map("row_count")
  columnCount     Int        @default(0) @map("column_count")
  detectedColumns String[]   @default([]) @map("detected_columns")
  sheetNames      String[]   @default([]) @map("sheet_names")

  validationState  FileValidationState @map("validation_state")
  validationReason String              @map("validation_reason")

  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("FileUploader", fields: [uploadedById], references: [id])

  @@index([applicationId])
  @@map("application_files")
}

/// A reserved direct-to-storage upload slot. The browser PUTs bytes straight to
/// object storage with a presigned URL, then confirms here; only `ready` rows
/// may be attached to a filing.
model Upload {
  id    String      @id @default(uuid()) @db.Uuid
  state UploadState @default(pending)

  originalName  String   @map("original_name")
  kind          FileKind
  mimeType      String   @map("mime_type")
  declaredBytes BigInt   @map("declared_bytes")
  storageKey    String   @unique @map("storage_key")
  storageDriver String   @map("storage_driver")

  /// Filled in when the object is verified present, from the storage backend.
  actualBytes    BigInt? @map("actual_bytes")
  checksumSha256 String? @map("checksum_sha256")
  failureReason  String? @map("failure_reason")

  uploadedById  String  @map("uploaded_by_id") @db.Uuid
  applicationId String? @map("application_id") @db.Uuid

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  uploadedBy  User         @relation("UploadOwner", fields: [uploadedById], references: [id])

  @@index([state])
  @@index([uploadedById])
  @@index([expiresAt])
  @@map("uploads")
}

// -------------------------------------------------------- audit & reports ---

/// Append-only audit trail: who moved a filing to which status, and when.
model StatusEvent {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  to          ApplicationStatus
  fromStatus  ApplicationStatus? @map("from_status")
  changedById String             @map("changed_by_id") @db.Uuid
  note        String?
  changedAt   DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([applicationId, changedAt])
  @@map("application_status_events")
}

/// Append-only record of every change to a filing's evidence: the original
/// upload, each replacement, and each deletion.
///
/// Separate from `StatusEvent` because that table's `to` column is an
/// `ApplicationStatus` — it can only describe moves through the filing's
/// lifecycle, and evidence changing is not a status change.
///
/// `fileId` is a plain uuid and deliberately **not** a foreign key to
/// `ApplicationFile`. A deletion has to be recorded, and the record has to
/// outlive the row it describes: with a real relation, deleting the file would
/// either cascade the log away or be refused by the constraint, and the one
/// event that most needs to survive is the one that destroys its subject.
/// There is no route that deletes a `FileEvent`, by the same reasoning.
model FileEvent {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  kind    FileEventKind
  actorId String        @map("actor_id") @db.Uuid

  /// Null for the file's own row once it is deleted.
  fileId String? @map("file_id") @db.Uuid

  filename       String
  sizeBytes      BigInt? @map("size_bytes")
  checksumSha256 String? @map("checksum_sha256")

  /// The state a replacement overwrote, so a swap can be checked against the
  /// bytes that were there before rather than taken on trust.
  previousFilename       String? @map("previous_filename")
  previousSizeBytes      BigInt? @map("previous_size_bytes")
  previousChecksumSha256 String? @map("previous_checksum_sha256")

  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User        @relation("FileEventActor", fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
  @@index([fileId])
  @@map("application_file_events")
}

/// The review result attached to a filing.
///
/// `resultData` stays schemaless on purpose: the report document is owned by
/// whichever produced it (a super admin today, the SiroQ Analysis Service
/// later), so the UI renders whatever keys arrive. `rawData` keeps the
/// untouched document for audit and debugging.
model Report {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @unique @map("application_id") @db.Uuid

  status ReportStatus @default(final)
  source ReportSource @default(manual)

  /// Normalised label/value pairs for the report panel.
  resultData Json   @default("{}") @map("result_data")
  /// Untouched upstream document, pretty-printed for the raw-data toggle.
  rawData    String @default("{}") @map("raw_data")

  generatedById String   @map("generated_by_id") @db.Uuid
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  /// Provenance when `source = service`.
  engineVersion String? @map("engine_version")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  generatedBy User        @relation(fields: [generatedById], references: [id])

  @@map("reports")
}

/// One invocation of the SiroQ Analysis Service for a filing. Recorded so the
/// integration stays observable, auditable and retryable when that service is
/// down or its contract changes.
model AnalysisRun {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  status AnalysisRunStatus @default(queued)

  /// Identifiers returned by the analysis service.
  analysisApplicationId String? @map("analysis_application_id")
  analysisId            String? @map("analysis_id")
  engineVersion         String? @map("engine_version")

  requestPayload  Json?   @map("request_payload")
  responseSummary Json?   @map("response_summary")
  errorMessage    String? @map("error_message")

  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  requestedById String    @map("requested_by_id") @db.Uuid

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy User        @relation(fields: [requestedById], references: [id])

  @@index([applicationId, startedAt])
  @@index([status])
  @@map("analysis_runs")
}

enum ExtractionRunStatus {
  queued
  running
  succeeded
  failed
}

enum ExtractionSource {
  upload
  url
}

enum ExtractionErrorCode {
  NONE
  NO_TABLE_FOUND
  INPUT_UNREADABLE
  UPSTREAM_QUOTA
  UPSTREAM_UNAVAILABLE
  UPSTREAM_REFUSED
  BLOCKED_BY_SAFETY
  OUTPUT_TRUNCATED
  TOO_LARGE
}

model ExtractionRun {
  id                 String              @id @default(uuid()) @db.Uuid
  status             ExtractionRunStatus @default(queued)
  source             ExtractionSource
  sourceName         String              @map("source_name")
  sourceUrl          String?             @map("source_url")
  sourceMime         String              @map("source_mime")
  sourceBytes        Int                 @map("source_bytes")
  sourceChecksum     String?             @map("source_checksum")
  uploadId           String?             @map("upload_id") @db.Uuid
  keySlot            Int?                @map("key_slot")
  attempts           Int                 @default(0)
  model              String
  finishReason       String?             @map("finish_reason")
  tableCount         Int                 @default(0) @map("table_count")
  tables             Json                @default("[]")
  csvBytes           Int?                @map("csv_bytes")
  csvTruncated       Boolean             @default(false) @map("csv_truncated")
  outputKey          String?             @map("output_key")
  outputName         String?             @map("output_name")
  errorCode          ExtractionErrorCode @default(NONE) @map("error_code")
  errorMessage       String?             @map("error_message")
  startedAt          DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  requestedById      String              @map("requested_by_id") @db.Uuid
  requestedBy        User                @relation("ExtractionRequester", fields: [requestedById], references: [id])

  @@index([status])
  @@index([requestedById, startedAt])
  @@index([uploadId])
  @@map("extraction_runs")
}
