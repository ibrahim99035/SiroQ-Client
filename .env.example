# ---------------------------------------------------------------------------
# SiroQ Client — environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored; this template is committed
# so a fresh checkout knows exactly what must be supplied.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Runtime traffic. On Neon use the POOLED endpoint; the direct endpoint goes in
# MIGRATIONS_DATABASE_URL below and is used by `prisma migrate` for DDL only.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
MIGRATIONS_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Local offline development (npm run db:up) — uncomment to use instead:
# DATABASE_URL="postgresql://siroq_client:siroq_client_dev_password@127.0.0.1:5434/siroq_client?schema=public"

# --- Object storage (uploaded .xlsx / .csv filings) ------------------------
# Only five variables are required to serve files. The bucket is private:
# browsers upload through a presigned URL for a single key, and reads are
# proxied through /api/uploads/[id]/content, so no credential is ever exposed
# to the client.
S3_ENDPOINT=""
S3_REGION="us-east-2"
S3_BUCKET="siroq-filings"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- Storage driver -------------------------------------------------------
# "neon"  — Neon Object Storage. Buckets are branch-scoped, so a preview branch
#           gets its own namespace and cannot touch production objects.
# "local" — writes under STORAGE_LOCAL_ROOT and streams back through a route
#           handler. For offline development; not durable across hosts.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./data/storage"

# --- Upload policy --------------------------------------------------------
# Enforced server-side against the bytes that actually land in storage, not
# against anything the browser claims.
UPLOAD_MAX_BYTES="52428800"
UPLOAD_ALLOWED_EXTENSIONS=".xlsx,.xls,.csv,.pbix,.pbit,.twb,.twbx,.tds,.tdsx,.hyper,.parquet,.json,.sql,.pdf"

# --- Sessions / auth ------------------------------------------------------
# No signing secret is needed: the session cookie carries an opaque random
# token and only its SHA-256 digest is stored, so reading the sessions table
# does not hand over a usable credential.
SESSION_COOKIE_NAME="siroq_session"
SESSION_TTL_HOURS="720"

# --- Seed ----------------------------------------------------------------
# Password given to every user created by `npm run db:seed`. Development only.
SEED_PASSWORD="siroq-dev-password"

# --- Email (password reset + workspace invites) ---------------------------
# Requires a Google App Password, not the account password. Port 465 is
# implicit TLS; 587 uses STARTTLS. Budget ~500 messages/day on a free account.
# When these are blank the app still works — links are written to the server log
# instead — so the flow stays testable without a mailbox.
#
# Also used for: filing status notifications, report-ready notices, and contact
# form submissions. Filing notifications are best-effort and never block the API
# response; the contact form does fail visibly, because a silently dropped
# enquiry is worse than an error the visitor can retry.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_APP_PASSWORD=""
# Envelope sender. Defaults to SMTP_USER when blank.
MAIL_FROM=""

# --- Contact form delivery -------------------------------------------------
# Where public enquiries from /contact are delivered. Falls back to MAIL_FROM,
# then SMTP_USER. If none of the three is set, the endpoint returns 503 and the
# visitor is told to email directly — it never pretends to have accepted a
# message it dropped.
CONTACT_INBOX_EMAIL=""

# --- Scheduling link (optional) -------------------------------------------
# When set, the contact form shows a "book a call" link and the scheduling
# section on /contact. When blank, that section is not rendered at all — the
# page never shows a dead scheduling button.
NEXT_PUBLIC_SCHEDULING_URL=""

# --- Absolute origin for links in outbound mail ---------------------------
# Optional. Set this in production, where the request host is not necessarily
# the public origin (e.g. behind a proxy on Vercel).
APP_BASE_URL=""

# --- SiroQ Analysis Service (separate Render service) ----------------------
# The service is deployed on its own host and is reached only from the server:
# the API key must never reach the browser, which is why every variable here is
# read inside server-only modules.
#
# Files are handed over as short-lived signed *read* URLs rather than uploaded.
# The two sides use different Neon branches, so the service has no credentials
# for this bucket, and streaming a filing through a serverless request would put
# it inside that request's wall-clock and body budget. That handoff needs
# STORAGE_DRIVER="neon" — the local driver has no bucket to sign against and
# falls back to sending the bytes inline, which is development-only.
#
# The run is queued and polled (POST, then GET): the analysis outlives the
# request that starts it, so the response is a run id, not a report.
#
# The integration is off unless ANALYSIS_SERVICE_ENABLED is "true" *and* a key is
# present. Half-configured reads as off on purpose — a button that always fails
# is worse than no button.
ANALYSIS_SERVICE_ENABLED="false"
# Include the /api/v1 prefix; this is the service's API root, not its origin.
  ANALYSIS_SERVICE_BASE_URL="http://127.0.0.1:8000/api/v1"
  ANALYSIS_SERVICE_API_KEY=""
  # Sizing notes, because the two plausible numbers here are both wrong:
  #
  # This is NOT bounded by the upload size cap. With STORAGE_DRIVER="neon" the
  # handoff posts presigned URLs, so the request body stays a few hundred bytes
  # no matter how large the filing is, and the service downloads the bytes later
  # in its own worker.
  #
  # It IS bounded by this process's own ceiling. Vercel Hobby functions stop at
  # 60s, so a value above that is not generosity — it is a timeout that can never
  # fire, and the request fails with the platform's error instead. Keep it well
  # under the platform limit so a hung service surfaces as a clear 504 here.
  ANALYSIS_SERVICE_TIMEOUT_MS="20000"
  # Only the wake probe (/health) ignores the value above, because waking a
  # suspended service is the point of that call: a cold start measured ~27s on the
  # free Render tier, so sharing the 20s budget made the sidebar's "Wake service"
  # button time out on every first press. Clamped internally to stay under this
  # runtime's function ceiling.
  ANALYSIS_WAKE_TIMEOUT_MS="45000"

# Table Extractor
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=
GEMINI_TIMEOUT_MS=45000
EXTRACTOR_ALLOW_URL=false
EXTRACTOR_ALLOWED_URLS=
EXTRACTOR_MAX_INPUT_BYTES=15000000
EXTRACTOR_MAX_CONCURRENT_PER_USER=2
EXTRACTOR_MAX_RUNS_PER_USER_PER_HOUR=30
EXTRACTOR_MAX_OUTPUT_TOKENS=32768
EXTRACTOR_KEY_COOLDOWN_MS=60000
EXTRACTOR_CSV_MODE=separate
EXTRACTOR_CSV_BOM=1
