# ---------------------------------------------------------------------------
# SiroQ Client — environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored; this template is committed
# so a fresh checkout knows exactly what must be supplied.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Neon: use the POOLED endpoint here. Direct endpoint goes in
# MIGRATIONS_DATABASE_URL below, used by `prisma migrate` only.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/siroq?sslmode=require"
MIGRATIONS_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/siroq?sslmode=require"
# Local offline development (docker compose up -d db) — uncomment to use instead:
# DATABASE_URL="postgresql://siroq_client:siroq_client_dev_password@127.0.0.1:5434/siroq_client?schema=public"

# --- Cloudinary (object storage + CDN for uploaded .xlsx/.csv) ------------
# API_SECRET is server-only. Never prefix any of these with NEXT_PUBLIC_.
# Files are uploaded with resource_type=raw via a signed upload, and read back
# through Cloudinary's CDN.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Gmail SMTP) ----------------------------------------------------
# Requires a Google App Password, not the account password. Host must be
# smtp.gmail.com on port 465 with TLS. Budget ~500 messages/day.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_APP_PASSWORD=""
MAIL_FROM=""


# --- Sessions / auth ------------------------------------------------------
# SESSION_SECRET must be a long random string. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string"
SESSION_COOKIE_NAME="siroq_session"
SESSION_TTL_HOURS="720"

# --- Object storage / CDN for uploaded .xlsx/.csv filings ------------------
# driver: "local" writes under STORAGE_LOCAL_ROOT and streams through a route
#         handler — used for offline development.
# driver: "cloudinary" issues a signed upload that the browser POSTs directly
#         to Cloudinary, bypassing the 4.5 MB Vercel function body limit.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./data/storage"
# Public/CDN base used to build read URLs (e.g. https://cdn.example.com).
STORAGE_PUBLIC_BASE_URL=""

# --- S3-compatible storage (alternative to Cloudinary; unused when
# --- STORAGE_DRIVER=cloudinary). Works with AWS S3, MinIO, Backblaze B2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="siroq-filings"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- Upload policy --------------------------------------------------------
UPLOAD_MAX_BYTES="52428800"
UPLOAD_ALLOWED_EXTENSIONS=".xlsx,.csv"

# --- SiroQ Analysis Service (the analytical app) — OPTIONAL ---------------
# The standalone app is fully functional with these disabled; enabling them
# only turns on the "send to analysis service" action on a filing.
ANALYSIS_SERVICE_ENABLED="false"
ANALYSIS_SERVICE_BASE_URL="http://127.0.0.1:8000/api/v1"
ANALYSIS_SERVICE_API_KEY=""
ANALYSIS_SERVICE_TIMEOUT_MS="120000"
