# npm install must be deterministic across machines.
#
# Context: package.json pins `eslint@^8.57.1` while `eslint-config-next@16.x`
# declares a peer of `eslint@>=9.0.0`. npm 7+ treats peer conflicts as hard
# errors, so a plain `npm install` fails on a fresh clone. The conflict is
# confined to dev-only lint tooling, so the peer check is relaxed here rather
# than uninstalling or force-upgrading ESLint as a side effect of unrelated work.
#
# Follow-up: align the ESLint major (and move to flat config, since ESLint 9+
# ignores .eslintrc.json by default) before treating lint as a CI gate.
legacy-peer-deps=true
